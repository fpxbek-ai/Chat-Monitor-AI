; Copy to config.ini locally. Never commit config.ini.
; Secrets belong in CHAT_MONITOR_* environment variables; see README_TEST_MODE_RU.md.
[telegram]
user_id = 0

[timezone]
name = Asia/Tashkent

[tdlib]
tdjson_path = /path/to/libtdjson.so
auth_mode = qr

[monitor]
; Exactly one permitted negative test-group ID. Empty means monitoring disabled.
chat_ids =
; Numeric ID of the separate TEST account. Zero blocks startup.
test_user_id = 0
